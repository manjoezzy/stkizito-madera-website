generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Admin {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  role      String   @default("admin")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AdmissionApplication {
  id              String   @id @default(cuid())
  referenceNumber String   @unique
  status          String   @default("pending") // pending, approved, rejected, enrolled
  
  // Personal Details
  fullName    String
  dob         String?
  gender      String?
  nationality String?
  religion    String?
  nin         String?
  
  // Contact
  phone         String
  email         String
  district      String?
  address       String?
  nextOfKin     String?
  nextOfKinPhone String?
  
  // Academic
  lastSchool      String?
  yearCompleted   String?
  qualification   String?
  institutionLevel String? // primary, o_level, a_level, tertiary, other
  grades           String? // JSON string: [{subject, grade}]

  // Program
  programme    String?
  intakeYear   String?
  
  // Payment
  paymentStatus  String   @default("pending") // pending, paid, failed
  paymentRef     String?
  paymentAmount  Float?
  paymentMethod  String?  // schoolpay, manual
  paidAt         DateTime?
  
  // SchoolPay
  schoolpayCode   String?

  documents   AdmissionDocument[]
  student    Student?
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Student {
  id            String   @id @default(cuid())
  studentNumber String   @unique
  applicationId String?  @unique
  application   AdmissionApplication? @relation(fields: [applicationId], references: [id])
  
  fullName      String
  phone         String
  email         String
  programme     String
  intakeYear    String
  status        String   @default("active") // active, graduated, suspended
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Payment {
  id              String   @id @default(cuid())
  transactionRef  String   @unique
  applicationRef  String?
  studentNumber   String?
  
  fullName        String
  phone           String
  email           String
  amount          Float
  currency        String   @default("UGX")
  status          String   @default("pending") // pending, successful, failed
  paymentMethod   String   @default("schoolpay")
  
  // SchoolPay specific
  schoolpayTxRef  String?
  schoolpayStatus String?
  
  metadata        String?  // JSON string for additional data
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Event {
  id            String   @id @default(cuid())
  title         String
  description   String?
  category      String   @default("general") // academic, showcase, assessment, campus
  eventDate     String?
  eventTime     String?
  location      String?
  isBanner      Boolean  @default(false)
  bannerUrl     String?
  attachmentUrl String?
  attachmentName String?
  isPublished   Boolean  @default(false)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String?
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model GalleryItem {
  id          String   @id @default(cuid())
  title       String
  description String?
  imageUrl    String
  category    String   @default("general") // outreach, sports, graduation, campus, openday, general
  eventDate   String?
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AdmissionDocument {
  id              String   @id @default(cuid())
  applicationId   String
  application     AdmissionApplication @relation(fields: [applicationId], references: [id])
  fileName        String
  fileUrl         String
  fileSize        Int
  documentType    String // national_id, academic_transcript, passport_photo, certificate, other
  createdAt       DateTime @default(now())
}

model SiteSetting {
  id    String @id @default(cuid())
  key   String @unique
  value String
  updatedAt DateTime @updatedAt
}

model Alumni {
  id            String   @id @default(cuid())
  fullName      String
  email         String?
  phone         String?
  graduationYear String?
  programme     String?
  occupation    String?
  employer      String?
  district      String?
  biography     String?
  isPublished   Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model GraduationItem {
  id          String   @id @default(cuid())
  title       String
  description String?
  itemType    String   @default("photo") // photo, video
  mediaUrl    String
  thumbnailUrl String?
  ceremonyYear String
  ceremonyName String?
  sortOrder   Int      @default(0)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
